# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — Bhadra Patibandla Cricket Portfolio
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets & credentials ─────────────────────────────────────────────────────
# Real Firebase config — NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.production
*.secret
*.key

# ── Local seed output ─────────────────────────────────────────────────────────
# Generated by inject-env-seed.js — contains real Firebase config injected in.
# The source file (seed-firestore.html) IS committed; this generated copy is not.
seed-firestore.local.html
*.local.html

# ── Build / CI output ─────────────────────────────────────────────────────────
# GitHub Actions builds the site into _site/ at deploy time — never commit it
_site/
dist/
build/
out/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────────────────────
*~
.fuse_hidden*
.nfs*

# ── Editors & IDEs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*.suo
.project
.classpath
.settings/

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/
package-lock.json
yarn.lock

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Temporary / misc ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.cache
.cache/
local/
.DS_Store

# ── Seed script artifacts ─────────────────────────────────────────────────────
sa-key.json           # Firebase Admin SDK service account key
_seed_data.json       # temporary file created during seeding
_seed_tmp.mjs         # temporary ES module wrapper created during seeding
sa-key.json